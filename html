      { id:"ed_empire", category:"edibles", name:"Empire Chocolate Bar", brand:"Empire", price:"$40", numericPrice:40, sizes:["3000mg"], thc:"3000mg", cbd:"—", effects:["Chocolate"], tags:["Edibles"], description:"Empire Bar 3000mg.", inStock:true, deal:false },
      { id:"ed_oobie", category:"edibles", name:"Oobie Doobie Double Shot", brand:"Oobie Doobie", price:"$10", numericPrice:10, sizes:["Drink"], thc:"—", cbd:"—", effects:["Drink"], tags:["Edibles"], description:"Double shot drink.", inStock:true, deal:false },
      { id:"ed_pint", category:"edibles", name:"Full Pint (bring jar)", brand:"Drinks", price:"$25", numericPrice:25, sizes:["Bring jar"], thc:"—", cbd:"—", effects:["Drink"], tags:["Edibles"], description:"Full pint (bring jar).", inStock:true, deal:false },

      // 🍄 MUSHROOMS
      { id:"ms_gaia", category:"mushrooms", name:"Gaia’s Gift 4G Chocolate Bars", brand:"Gaia’s Gift", price:"$35", numericPrice:35, sizes:["4G"], thc:"—", cbd:"—", effects:["Chocolate"], tags:["Mushrooms"], description:"Gaia’s Gift 4G chocolate bars.", inStock:true, deal:false },
      { id:"ms_caps", category:"mushrooms", name:"Mushroom Capsules 4G", brand:"Capsules", price:"$35", numericPrice:35, sizes:["4G"], thc:"—", cbd:"—", effects:["Capsules"], tags:["Mushrooms"], description:"Mushroom capsules 4G.", inStock:true, deal:false },
      { id:"ms_bulk", category:"mushrooms", name:"Bulk Mushrooms (Pricing)", brand:"Bulk", price:"From $30", numericPrice:30, sizes:["Bulk pricing available","1/8 – $30","Quarter – $60","Half – $100","Full – $200"], thc:"—", cbd:"—", effects:["Bulk"], tags:["Mushrooms"], description:"Bulk pricing available by weight.", inStock:true, deal:false },
    ];

    const CATEGORIES = [
      { key:"flower", title:"Flower", icon:"🌿", sub:"Flower + Pre-Rolls", tag:"MENU" },
      { key:"vapes", title:"Vapes", icon:"💨", sub:"Disposables & Pods", tag:"MENU" },
      { key:"concentrates", title:"Concentrates", icon:"🧪", sub:"Wax / Dab + RSO", tag:"MENU" },
      { key:"edibles", title:"Edibles", icon:"🍬", sub:"Gummies • Bars • Drinks", tag:"MENU" },
      { key:"mushrooms", title:"Mushrooms", icon:"🍄", sub:"Bars • Caps • Bulk", tag:"MENU" },
    ];

    // Shopping list state
    let shoppingList = [];

    // DOM elements
    const elHome = document.getElementById("viewHome");
    const elCat = document.getElementById("viewCategory");
    const categoryGrid = document.getElementById("categoryGrid");
    const itemGrid = document.getElementById("itemGrid");
    const categoryTitle = document.getElementById("categoryTitle");
    const categorySub = document.getElementById("categorySub");
    const btnBack = document.getElementById("btnBack");

    const sheetOverlay = document.getElementById("sheetOverlay");
    const sheet = document.getElementById("sheet");
    const sheetName = document.getElementById("sheetName");
    const sheetMeta = document.getElementById("sheetMeta");
    const sheetPrice = document.getElementById("sheetPrice");
    const sheetThc = document.getElementById("sheetThc");
    const sheetCbd = document.getElementById("sheetCbd");
    const sheetDesc = document.getElementById("sheetDesc");
    const sheetEffects = document.getElementById("sheetEffects");
    const sizesWrap = document.getElementById("sizesWrap");
    const sheetSizes = document.getElementById("sheetSizes");

    const btnCall = document.getElementById("btnCall");
    const btnText = document.getElementById("btnText");
    const btnCopy = document.getElementById("btnCopy");
    const btnClose = document.getElementById("btnClose");
    const btnAddToList = document.getElementById("btnAddToList");

    // Shopping list elements
    const cartPill = document.getElementById("cartPill");
    const cartTotal = document.getElementById("cartTotal");
    const cartCount = document.getElementById("cartCount");
    const shoppingListPanel = document.getElementById("shoppingListPanel");
    const closeListBtn = document.getElementById("closeListBtn");
    const listItems = document.getElementById("listItems");
    const listTotal = document.getElementById("listTotal");
    const listCallBtn = document.getElementById("listCallBtn");
    const listTextBtn = document.getElementById("listTextBtn");
    const clearListBtn = document.getElementById("clearListBtn");

    let activeCategory = null;
    let currentProduct = null;

    const normalizePhone = (p) => p.replace(/[^\d+]/g, "");
    const telHref = "tel:" + normalizePhone(STORE.phone);
    const smsHref = "sms:" + normalizePhone(STORE.text);

    // Shopping list functions
    function updateCartDisplay() {
      const total = shoppingList.reduce((sum, item) => sum + (item.numericPrice || 0), 0);
      cartTotal.textContent = `$${total}`;
      cartCount.textContent = shoppingList.length;

      // Update list panel
      if (shoppingList.length === 0) {
        listItems.innerHTML = '<div style="text-align: center; color: var(--muted); padding: 40px 0;">Your list is empty 🛒<br><br>Tap items and click "Add to List"</div>';
      } else {
        listItems.innerHTML = shoppingList.map(item => `
          <div class="list-item" data-item-id="${item.id}">
            <div class="item-info">
              <div class="item-name">${escapeHtml(item.name)}</div>
              <div class="item-meta">${escapeHtml(item.brand || "House")} • ${escapeHtml(prettyCat(item.category))}</div>
            </div>
            <div class="item-price">${escapeHtml(item.price)}</div>
            <button class="remove-item" onclick="removeFromList('${item.id}')" aria-label="Remove">✕</button>
          </div>
        `).join('');
      }
      listTotal.textContent = `$${total}`;

      // Update call/text links with list summary
      const listSummary = shoppingList.map(item => `${item.name} (${item.price})`).join(', ');
      const orderText = `Order request: ${listSummary}`;
      listCallBtn.href = telHref;
      listTextBtn.href = smsHref + `?&body=${encodeURIComponent(orderText)}`;
    }

    window.removeFromList = function(itemId) {
      shoppingList = shoppingList.filter(item => item.id !== itemId);
      updateCartDisplay();
    };

    function addToList(product) {
      // Check if already in list
      if (shoppingList.some(item => item.id === product.id)) {
        alert('Item already in your list!');
        return;
      }
      shoppingList.push(product);
      updateCartDisplay();

      // Show feedback
      btnAddToList.textContent = "✅ Added!";
      setTimeout(() => btnAddToList.textContent = "➕ Add to Shopping List", 1000);
    }

    function clearList() {
      if (shoppingList.length > 0 && confirm('Clear your entire shopping list?')) {
        shoppingList = [];
        updateCartDisplay();
      }
    }

    // Original functions (preserved)
    function showHome(){
      elHome.hidden = false;
      elCat.hidden = true;
      activeCategory = null;
      closeSheet();
    }

    function showCategory(key){
      activeCategory = key;
      elHome.hidden = true;
      elCat.hidden = false;

      const cat = CATEGORIES.find(c=>c.key===key);
      categoryTitle.textContent = cat ? cat.title : key.toUpperCase();

      categorySub.textContent =
        key === "flower" ? "Flower pricing + pre-rolls" :
        key === "vapes" ? "Disposables & pods — flavors vary" :
        key === "concentrates" ? "Wax / dab + RSO" :
        key === "edibles" ? "Gummies • chocolate • drinks" :
        key === "mushrooms" ? "Chocolate • capsules • bulk" :
        "Tap an item to view details";

      renderItems(key);
      closeSheet();
    }

    function renderCategories(){
      categoryGrid.innerHTML = CATEGORIES.map(c=>`
        <div class="tile" data-open-category="${c.key}" role="button" tabindex="0" aria-label="${c.title}">
          <div class="tile__top">
            <div class="tile__icon">${c.icon}</div>
            <div>
              <div class="tile__title">${escapeHtml(c.title)}</div>
              <div class="tile__sub">${escapeHtml(c.sub)}</div>
            </div>
          </div>
          <div class="tile__tag">${escapeHtml(c.tag)}</div>
        </div>
      `).join("");
    }

    function renderGroup(title, sub){
      return `
        <div class="groupHeader" aria-hidden="true">
          <div class="groupHeader__title">${escapeHtml(title)}</div>
          <div class="groupHeader__sub">${escapeHtml(sub || "")}</div>
        </div>
      `;
    }

    function renderTile(p){
      const deal = p.deal ? " • DEAL" : "";
      return `
        <div class="tile" data-open-item="${p.id}" role="button" tabindex="0" aria-label="${escapeHtml(p.name)}">
          <div class="tile__top">
            <div class="tile__icon">${iconForCategory(p.category)}</div>
            <div>
              <div class="tile__title">${escapeHtml(p.name)}</div>
              <div class="tile__sub">${escapeHtml(p.brand || "House")} • ${escapeHtml(prettyCat(p.category))}${deal}</div>
            </div>
          </div>
          <div class="tile__tag">${escapeHtml(p.price || "")}</div>
        </div>
      `;
    }

    function renderItems(key){
      let html = "";

      if (key === "flower") {
        const flowerItems = PRODUCTS.filter(p=>p.category==="flower");
        html += renderGroup("🌿 Flower", "Strains vary");
        html += flowerItems.map(renderTile).join("");

        const pre = PRODUCTS.filter(p=>p.category==="prerolls");
        html += renderGroup("🚬 Pre-Rolls", "Singles & packs");
        html += pre.map(renderTile).join("");
      } else if (key === "vapes") {
        html += renderGroup("💨 Vapes", "Disposables & pods • flavors vary");
        html += PRODUCTS.filter(p=>p.category==="vapes").map(renderTile).join("");
      } else {
        html += PRODUCTS.filter(p=>p.category===key).map(renderTile).join("");
      }

      itemGrid.innerHTML = html || renderGroup("No items", "Nothing to show");
    }

    function iconForCategory(key){
      if (key === "flower") return "🌿";
      if (key === "prerolls") return "🚬";
      if (key === "vapes") return "💨";
      if (key === "concentrates") return "🧪";
      if (key === "edibles") return "🍬";
      if (key === "mushrooms") return "🍄";
      return "☰";
    }

    function prettyCat(key){
      const map = {
        flower: "Flower",
        prerolls: "Pre-Rolls",
        vapes: "Vapes",
        concentrates: "Concentrates",
        edibles: "Edibles",
        mushrooms: "Mushrooms"
      };
      return map[key] || key;
    }

    function openSheet(product){
      currentProduct = product;
      sheetName.textContent = product.name;
      sheetMeta.textContent = `${product.brand || "House"} • ${prettyCat(product.category)}${product.deal ? " • DEAL" : ""}`;
      sheetPrice.textContent = product.price || "—";
      sheetThc.textContent = product.thc || "—";
      sheetCbd.textContent = product.cbd || "—";
      sheetDesc.textContent = product.description || "—";

      // Notes/effects chips
      const notes = (product.effects || []).slice(0, 10);
      sheetEffects.innerHTML = notes.length
        ? notes.map(e=>`<span class="chip">${escapeHtml(e)}</span>`).join("")
        : `<span class="chip">—</span>`;

      // Price/options chips
      const sizes = product.sizes || [];
      if (sizes.length){
        sizesWrap.hidden = false;
        sheetSizes.innerHTML = sizes.map(s=>`<span class="chip">${escapeHtml(s)}</span>`).join("");
      } else {
        sizesWrap.hidden = true;
        sheetSizes.innerHTML = "";
      }

      btnCall.href = telHref;
      btnText.href = smsHref + `?&body=${encodeURIComponent("Order request: " + product.name)}`;

      sheetOverlay.classList.add("is-open");
      sheet.classList.add("is-open");
    }

    function closeSheet(){
      sheetOverlay.classList.remove("is-open");
      sheet.classList.remove("is-open");
      currentProduct = null;
    }

    // Event Listeners
    btnCopy.addEventListener("click", async ()=>{
      const text = sheetName.textContent.trim();
      try{
        await navigator.clipboard.writeText(text);
        btnCopy.textContent = "Copied ✓";
        setTimeout(()=>btnCopy.textContent="Copy Name", 900);
      }catch{
        btnCopy.textContent = "Copy failed";
        setTimeout(()=>btnCopy.textContent="Copy Name", 900);
      }
    });

    btnAddToList.addEventListener("click", ()=>{
      if (currentProduct) {
        addToList(currentProduct);
      }
    });

    sheetOverlay.addEventListener("click", closeSheet);
    btnClose.addEventListener("click", closeSheet);

    // Swipe down close
    let startY = 0;
    sheet.addEventListener("touchstart", (e)=>{ startY = e.touches[0].clientY; }, {passive:true});
    sheet.addEventListener("touchmove", (e)=>{
      const dy = e.touches[0].clientY - startY;
      if (dy > 0){
        e.preventDefault();
        sheet.style.transform = `translateY(${dy}px)`;
      }
    }, {passive:false});
    sheet.addEventListener("touchend", (e)=>{
      const dy = e.changedTouches[0].clientY - startY;
      sheet.style.transform = "";
      if (dy > 100) closeSheet();
    }, {passive:true});

    document.addEventListener("click", (e)=>{
      const catBtn = e.target.closest("[data-open-category]");
      if (catBtn){
        showCategory(catBtn.dataset.openCategory);
        return;
      }
      const itemBtn = e.target.closest("[data-open-item]");
      if (itemBtn){
        const p = PRODUCTS.find(x=>x.id===itemBtn.dataset.openItem);
        if (p) openSheet(p);
        return;
      }
    });

    btnBack.addEventListener("click", showHome);

    // Shopping list panel controls
    cartPill.addEventListener("click", ()=>{
      shoppingListPanel.classList.add("open");
    });

    closeListBtn.addEventListener("click", ()=>{
      shoppingListPanel.classList.remove("open");
    });

    clearListBtn.addEventListener("click", clearList);

    document.addEventListener("keydown", (e)=>{
      if (e.key === "Escape"){
        if (shoppingListPanel.classList.contains("open")) {
          shoppingListPanel.classList.remove("open");
        } else if (sheet.classList.contains("is-open")) {
          closeSheet();
        } else {
          showHome();
        }
      }
    });

    function escapeHtml(str){
      return String(str ?? "")
        .replaceAll("&","&amp;")
        .replaceAll("<","&lt;")
        .replaceAll(">","&gt;")
        .replaceAll('"',"&quot;")
        .replaceAll("'","&#039;");
    }

    // Initialize
    renderCategories();
    showHome();
    updateCartDisplay();
  </script>
